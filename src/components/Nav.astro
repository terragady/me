---
import { navLinks, site } from "../config";
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-border/50 bg-bg/60 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4"
    aria-label="Primary"
  >
    <a href="#home" class="font-mono text-sm font-semibold tracking-tight">
      {site.name.split(" ")[0]}<span class="text-accent">.</span>
    </a>
    <ul class="flex items-center gap-6 text-sm">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav
              class="text-muted transition-colors hover:text-fg"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
