---
import { navLinks, site } from "../config";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-bg/70 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4"
    aria-label="Primary"
  >
    <a href="/" class="font-mono text-sm font-semibold tracking-tight">
      {site.name.split(" ")[0]}<span class="text-accent">.</span>
    </a>
    <ul class="flex items-center gap-6 text-sm">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "transition-colors hover:text-fg",
                isActive(link.href) ? "text-fg" : "text-muted",
              ]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
