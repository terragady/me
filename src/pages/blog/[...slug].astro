---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <a href="/blog" class="font-mono text-sm text-muted hover:text-accent"
    >← Back to blog</a
  >
  <article class="mt-6">
    <time
      class="font-mono text-xs text-muted"
      datetime={post.data.date.toISOString()}
    >
      {dateFmt(post.data.date)}
    </time>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">{post.data.title}</h1>
    <div
      class="prose prose-invert mt-8 max-w-none prose-a:text-accent prose-headings:tracking-tight"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
