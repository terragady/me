---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });
---

<BaseLayout title="Blog" description="Notes, articles and writing.">
  <h1 class="text-3xl font-bold tracking-tight">Blog</h1>
  <p class="mt-3 text-muted">Notes and articles.</p>

  <ul class="mt-10 space-y-8">
    {
      posts.map((post) => (
        <li>
          <time
            class="font-mono text-xs text-muted"
            datetime={post.data.date.toISOString()}
          >
            {dateFmt(post.data.date)}
          </time>
          <h2 class="mt-1 text-xl font-semibold">
            <a href={`/blog/${post.id}`} class="hover:text-accent">
              {post.data.title}
            </a>
          </h2>
          <p class="mt-2 text-muted">{post.data.description}</p>
        </li>
      ))
    }
    {posts.length === 0 && <li class="text-muted">No posts yet — check back soon.</li>}
  </ul>
</BaseLayout>
