---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TypingTagline from "../components/TypingTagline.tsx";
import SocialIcon from "../components/SocialIcon.astro";
import {
  site,
  socialLinks,
  skills,
  education,
  publications,
  languages,
  interests,
  contactFormAccessKey,
} from "../config";

const work = (await getCollection("work")).sort(
  (a, b) => b.data.order - a.data.order,
);

const scholar =
  socialLinks.find((l) => l.label === "Google Scholar")?.href ?? "#";
---

<BaseLayout>
  <!-- HERO -->
  <section
    id="home"
    data-section="home"
    class="relative mx-auto flex min-h-[calc(100svh-4rem)] max-w-3xl flex-col justify-center px-6 pt-24 pb-16"
  >
    <div class="animate-rise">
      <p class="font-mono text-sm text-muted">Hi, my name is</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-6xl">
        {site.name}
      </h1>
      <p class="mt-4 text-lg text-muted">
        <TypingTagline
          client:load
          phrases={[
            "Senior Software Developer",
            "React · TypeScript · Node.js",
            "Based in Oslo, Norway",
          ]}
        />
      </p>

      <p class="mt-8 max-w-2xl leading-relaxed text-fg/90">
        Senior full-stack developer with 7+ years building and shipping production
        web and mobile applications, currently in financial services at Storebrand.
        I work end to end — React/TypeScript front-ends, Node.js/GraphQL back-ends,
        and cloud/CI-CD — with a focus on quality, accessibility and maintainable
        code. A former research scientist (PhD), I bring analytical rigour and clear
        communication to every team.
      </p>

      <div class="mt-8 flex flex-wrap gap-4 text-sm">
        <a
          href="#contact"
          class="rounded-md bg-accent px-4 py-2 font-medium text-bg transition-opacity hover:opacity-90"
        >
          Get in touch
        </a>
        {
          socialLinks.map((l) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-md border border-border bg-surface/60 px-4 py-2 font-medium text-fg/80 transition-colors hover:border-accent hover:bg-surface hover:text-accent"
            >
              <SocialIcon name={l.icon} class="h-4 w-4" />
              {l.label}
            </a>
          ))
        }
      </div>
    </div>

    <a
      href="#work"
      class="scroll-cue"
      aria-label="Scroll down to see my experience"
    >
      <span class="scroll-cue-mouse" aria-hidden="true"></span>
    </a>
  </section>

  <!-- WORK / EXPERIENCE -->
  <section id="work" data-section="work" class="mx-auto max-w-3xl px-6 py-24">
    <h2 class="reveal text-2xl font-semibold tracking-tight">Experience</h2>
    <div class="mt-10 space-y-10">
      {
        work.map(async (item) => {
          const { Content } = await render(item);
          return (
            <article class="reveal border-l border-border pl-6">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-lg font-semibold">
                  {item.data.link ? (
                    <a
                      href={item.data.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-accent"
                    >
                      {item.data.title} ↗
                    </a>
                  ) : (
                    item.data.title
                  )}
                </h3>
                {item.data.period && (
                  <span class="font-mono text-xs text-muted">{item.data.period}</span>
                )}
              </div>
              {item.data.role && (
                <p class="mt-1 text-sm text-accent">{item.data.role}</p>
              )}
              <p class="mt-3 text-fg/90">{item.data.summary}</p>
              <div class="prose prose-invert mt-3 max-w-none text-sm text-muted">
                <Content />
              </div>
              {item.data.tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {item.data.tags.map((tag) => (
                    <li class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- SKILLS / EDUCATION / PUBLICATIONS -->
  <section id="skills" data-section="skills" class="mx-auto max-w-3xl px-6 py-24">
    <h2 class="reveal text-2xl font-semibold tracking-tight">Skills</h2>
    <dl class="mt-8 space-y-4">
      {
        skills.map((s) => (
          <div class="reveal sm:grid sm:grid-cols-[220px_1fr] sm:gap-4">
            <dt class="font-mono text-sm text-accent">{s.group}</dt>
            <dd class="mt-1 text-sm text-muted sm:mt-0">{s.items}</dd>
          </div>
        ))
      }
    </dl>

    <h3 class="reveal mt-16 text-xl font-semibold">Education</h3>
    <ul class="mt-6 space-y-4">
      {
        education.map((e) => (
          <li class="reveal">
            <p class="font-medium">{e.degree}</p>
            <p class="text-sm text-muted">{e.org}</p>
            <p class="font-mono text-xs text-muted">{e.note}</p>
          </li>
        ))
      }
    </ul>

    <h3 class="reveal mt-16 text-xl font-semibold">Selected publications</h3>
    <p class="reveal mt-3 text-sm text-muted">
      Full list on{" "}
      <a href={scholar} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
        Google Scholar
      </a>.
    </p>
    <ul class="mt-4 space-y-3 text-sm text-muted">
      {publications.map((p) => <li class="reveal border-l border-border pl-4">{p}</li>)}
    </ul>

    <div class="mt-16 grid gap-12 sm:grid-cols-2">
      <div>
        <h3 class="reveal text-xl font-semibold">Languages</h3>
        <ul class="mt-6 space-y-2 text-sm">
          {
            languages.map((l) => (
              <li class="reveal flex items-baseline justify-between gap-4 border-b border-border/60 pb-2">
                <span class="text-fg/90">{l.name}</span>
                <span class="font-mono text-xs text-muted">{l.level}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="reveal text-xl font-semibold">Interests</h3>
        <ul class="mt-6 space-y-3 text-sm text-muted">
          {
            interests.map((interest) => (
              <li class="reveal border-l border-border pl-4">{interest}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section
    id="contact"
    data-section="contact"
    class="mx-auto flex min-h-[70svh] max-w-3xl flex-col justify-center px-6 py-24"
  >
    <h2 class="reveal text-2xl font-semibold tracking-tight">Contact</h2>
    <p class="reveal mt-4 max-w-2xl leading-relaxed text-fg/90">
      Have a project, role or question in mind? Send me a message and I'll get
      back to you.
    </p>

    <form
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      class="reveal mt-8 max-w-xl space-y-5"
    >
      <input type="hidden" name="access_key" value={contactFormAccessKey} />
      <input type="hidden" name="subject" value="New message from michalik.no" />
      <input type="hidden" name="from_name" value="michalik.no contact form" />
      <!-- Honeypot: bots fill this, humans never see it -->
      <input
        type="checkbox"
        name="botcheck"
        class="hidden"
        tabindex="-1"
        autocomplete="off"
      />

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label
            for="contact-name"
            class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-muted"
          >
            Name
          </label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-fg placeholder:text-muted/60 transition-colors focus:border-accent focus:outline-none"
            placeholder="Your name"
          />
        </div>
        <div>
          <label
            for="contact-email"
            class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-muted"
          >
            Email
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-fg placeholder:text-muted/60 transition-colors focus:border-accent focus:outline-none"
            placeholder="you@example.com"
          />
        </div>
      </div>

      <div>
        <label
          for="contact-message"
          class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-muted"
        >
          Message
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          required
          class="w-full resize-y rounded-md border border-border bg-surface px-3 py-2 text-sm text-fg placeholder:text-muted/60 transition-colors focus:border-accent focus:outline-none"
          placeholder="What would you like to talk about?"></textarea>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <button
          type="submit"
          class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-bg transition-colors hover:bg-accent-strong disabled:cursor-not-allowed disabled:opacity-60"
        >
          Send message
        </button>
        <p
          data-form-status
          role="status"
          aria-live="polite"
          class="text-sm"
        >
        </p>
      </div>
    </form>

    <p class="reveal mt-10 text-sm text-muted">
      Or find me on{" "}
      {
        socialLinks.map((l, i) => (
          <>
            {i > 0 && <span class="text-border"> · </span>}
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-accent"
            >
              <SocialIcon name={l.icon} class="h-3.5 w-3.5" />
              {l.label} ↗
            </a>
          </>
        ))
      }
    </p>
  </section>

  <script>
    const init = () => {
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      // Scroll-driven background-glow colours + hide the scroll cue.
      // A ring of pastel hues is walked continuously as you scroll (no snapping
      // to sections), and the three blobs each sit at a different point on the
      // ring so several distinct hues are on screen at once.
      const root = document.documentElement;
      const glow = document.querySelector<HTMLElement>(".page-glow");
      const scrollCue = document.querySelector<HTMLElement>(".scroll-cue");

      // Aurora bands, evenly spaced around the wheel (all hues weighted equally).
      const palette: [number, number, number][] = [
        [70, 240, 170], // aurora green
        [45, 212, 191], // teal
        [56, 200, 230], // cyan
        [96, 165, 250], // blue
        [129, 140, 248], // indigo
        [167, 139, 250], // violet
        [192, 132, 252], // purple
        [232, 121, 249], // magenta
        [244, 114, 182], // pink
        [251, 113, 133], // rose
      ];
      // Interpolate the ring at a cyclic position t (0..1) → an [r,g,b].
      const hueAt = (t: number): [number, number, number] => {
        const n = palette.length;
        const x = (((t % 1) + 1) % 1) * n;
        const i = Math.floor(x);
        const f = x - i;
        const a = palette[i % n];
        const b = palette[(i + 1) % n];
        return [
          Math.round(a[0] + (b[0] - a[0]) * f),
          Math.round(a[1] + (b[1] - a[1]) * f),
          Math.round(a[2] + (b[2] - a[2]) * f),
        ];
      };
      const rgba = (c: [number, number, number], alpha: number) =>
        `rgba(${c[0]}, ${c[1]}, ${c[2]}, ${alpha})`;

      // Hue position combines a slow, always-on ambient drift (so the colours
      // keep shifting even at rest, like a real aurora) with the scroll offset.
      let ambient = 0; // palette loops accumulated over time
      let scrollHue = 0; // palette offset from scroll position (~1.5 loops/page)
      const AMBIENT_RATE = 1 / 55000; // one full palette loop ≈ 55s at rest

      const paintColours = () => {
        const t = ambient + scrollHue;
        root.style.setProperty("--glow-1", rgba(hueAt(t), 0.24));
        root.style.setProperty("--glow-2", rgba(hueAt(t + 0.16), 0.24));
        root.style.setProperty("--glow-3", rgba(hueAt(t + 0.33), 0.2));
      };

      let ticking = false;
      const onScroll = () => {
        const y = window.scrollY;
        if (!reduce) {
          const max = root.scrollHeight - window.innerHeight;
          const progress = max > 0 ? y / max : 0;
          scrollHue = progress * 1.5;
          paintColours();
          // Gentle whole-field rotation instead of an upward parallax slide.
          if (glow) {
            glow.style.setProperty("--scroll-rotate", `${progress * 12}deg`);
          }
        }
        if (scrollCue) {
          scrollCue.classList.toggle("is-hidden", y > 24);
        }
        ticking = false;
      };
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(onScroll);
          }
        },
        { passive: true },
      );
      onScroll();

      // Ambient colour loop. rAF auto-pauses when the tab is hidden; colour
      // repaints are throttled to ~12fps since the drift is slow anyway.
      if (!reduce) {
        let prev: number | null = null;
        let lastPaint = 0;
        const tick = (now: number) => {
          if (prev === null) prev = now;
          // Clamp dt so returning to a backgrounded tab doesn't jump the hue.
          const dt = Math.min(now - prev, 100);
          prev = now;
          ambient += dt * AMBIENT_RATE;
          if (now - lastPaint > 80) {
            lastPaint = now;
            paintColours();
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      // Reveal-on-scroll
      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduce) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 },
        );
        revealEls.forEach((el) => revealObserver.observe(el));
      }

      // Scroll-spy: highlight the active nav link for the section in view.
      const navLinks =
        document.querySelectorAll<HTMLAnchorElement>("[data-nav]");
      const sections =
        document.querySelectorAll<HTMLElement>("section[data-section]");

      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = entry.target.id;
            navLinks.forEach((link) =>
              link.classList.toggle(
                "nav-active",
                link.getAttribute("href") === `#${id}`,
              ),
            );
          });
        },
        { rootMargin: "-45% 0px -50% 0px", threshold: 0 },
      );
      sections.forEach((section) => spy.observe(section));

      // Contact form — submit to Web3Forms without leaving the page.
      const form = document.getElementById(
        "contact-form",
      ) as HTMLFormElement | null;
      if (form) {
        const statusEl =
          form.querySelector<HTMLElement>("[data-form-status]");
        const submitBtn =
          form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const setStatus = (message: string, tone: string) => {
          if (statusEl) {
            statusEl.textContent = message;
            statusEl.className = `text-sm ${tone}`;
          }
        };

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;

          if (submitBtn) submitBtn.disabled = true;
          setStatus("Sending…", "text-muted");

          try {
            const response = await fetch(form.action, {
              method: "POST",
              headers: { Accept: "application/json" },
              body: new FormData(form),
            });
            const result = await response.json();
            if (response.ok && result.success) {
              form.reset();
              setStatus("Thanks! Your message has been sent.", "text-accent");
            } else {
              throw new Error(result.message || "Request failed");
            }
          } catch {
            setStatus(
              "Sorry, something went wrong. Please try again or email me directly.",
              "text-red-400",
            );
          } finally {
            if (submitBtn) submitBtn.disabled = false;
          }
        });
      }
    };

    init();
  </script>
</BaseLayout>
