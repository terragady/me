---
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialLinks } from "../config";
---

<BaseLayout title="Contact" description="Get in touch with Marcin Michalik.">
  <h1 class="text-3xl font-bold tracking-tight">Contact</h1>
  <p class="mt-4 max-w-2xl leading-relaxed text-fg/90">
    The best way to reach me is on LinkedIn — feel free to connect or send a
    message. You can also find my code on GitHub and my research on Google
    Scholar.
  </p>

  <ul class="mt-10 space-y-3">
    {
      socialLinks.map((l) => (
        <li>
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg text-muted transition-colors hover:text-accent"
          >
            {l.label} ↗
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
